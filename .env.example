# OnlineJobs.ph credentials
OJ_EMAIL=your-email@gmail.com
OJ_PASSWORD=your-password

# Job search URL
# Comma-separated search keywords (prioritizes same-day posted jobs)
JOB_KEYWORDS=React,Software Engineer,AI Engineer,Backend Developer

# How many search result pages to browse (uses more connects)
MAX_SEARCH_PAGES=5

# Stop when connects reach this number (0 = use all connects)
MIN_CONNECTS_RESERVE=0

# Server port
PORT=3847

# Persistent data directory (Railway: mount volume at /app/data)
# DATA_DIR=/app/data

# Headless browser (set to false to watch the agent work)
HEADLESS=true
